\begin_body

\begin_layout Standard
Our goal is to study spin echo with finite duration pulse.
 Some papers showed that finite-duration pulse can lead to non-negligible
 effect.
\end_layout

\begin_layout Standard
We have a Hamiltonian in lab frame
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
{\cal H}=-\gamma_{e}H_{0}S_{z}+\gamma_{n}H_{0}I_{z}+A\boldsymbol{S}\cdot\boldsymbol{I}+x(t)\omega_{1}(t)(S_{x}\cos(\omega t)+S_{y}\sin(\omega t))+
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
+y(t)\omega_{1}(t)(-S_{x}\sin(\omega t)+S_{y}\cos(\omega t))
\]

\end_inset


\end_layout

\begin_layout Standard
First and second terms are Zeeman fields for electron and nuclear species,
 third term is hyperfine coupling, fourth term is 
\begin_inset Formula $X$
\end_inset

-pulse, fifth term is 
\begin_inset Formula $Y$
\end_inset

-pulse.
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\omega_{1}(t)=\omega_{1}(1-0.956(t/T_{2})^{2})e^{-(t/T_{2})^{2}}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $-1\leq x(t)\leq1,-1\leq y(t)\leq1$
\end_inset

 - modulation of signals, 
\begin_inset Formula $T_{2}$
\end_inset

 is width of the signal
\end_layout

\begin_layout Standard
hyperfine interaction can be separated into secular and nonsecular contributions
,
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
A\boldsymbol{S}\cdot\boldsymbol{I}\approx AS_{z}(a_{\parallel}I_{z}+a_{\perp}I_{x})
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
with 
\begin_inset Formula $a_{\parallel}=A\cos\theta$
\end_inset

 , 
\begin_inset Formula $a_{\perp}=A\sin\theta$
\end_inset

.
\end_layout

\begin_layout Standard
We have a Hamiltonian in rotating frame
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
{\cal H}={\cal H}_{0}+{\cal H}_{P}(t)
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
{\cal H}_{0}=a_{\perp}\hat{S}_{z}\hat{I}_{x}+a_{\parallel}S_{z}I_{z}+\omega_{n}I_{z}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
{\cal H}_{P}(t)=x(t)\omega_{1}(t)S_{x}+y(t)\omega_{1}(t)S_{y}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
We have evolution 
\begin_inset Formula $(\tau-\pi_{x}-2\tau-\pi_{y}-2\tau-\pi_{-x}-2\tau-\pi_{-y}-\tau)^{N}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
U=U_{\pi/2}U_{block}^{N}U_{\pi/2}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
where
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
U_{block}=U({\cal H}_{0},\tau)U_{\pi_{-y}}U({\cal H}_{0},2\tau)U_{\pi_{-x}}U({\cal H}_{0},2\tau)U_{\pi_{y}}U({\cal H}_{0},2\tau)U_{\pi_{x}}U({\cal H}_{0},\tau)
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
So, if we have ideal pulses 
\begin_inset Formula $\omega_{1}(t)t_{w}=\pi$
\end_inset

, we have these Hamiltonians and evolution for different time intervals.
\end_layout

\begin_layout Standard
We have non-ideal pulses with flip angle 
\begin_inset Formula $\beta=\int_{-\infty}^{\infty}\omega_{1}(t)dt=0.925221\omega_{1}T_{2}=\pi+\epsilon$
\end_inset

.
\end_layout

\begin_layout Standard
We want to apply average Hamiltonian theory, but we don't have the condition
 
\begin_inset Formula $||{\cal H}_{A}||T\ll1$
\end_inset

, since hyperfine is strong.
 To use perturbation theory we should have a small parameter.
 We should transfrom our unitary operation
\end_layout

\begin_layout Standard
So, we have the Hamiltonian between pulses after 
\begin_inset Formula $\pi_{x}/2$
\end_inset

 rotation
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
{\cal H}_{0}=a_{\perp}\hat{S}_{y}\hat{I}_{x}+a_{\parallel}S_{y}I_{z}+\omega_{n}I_{z}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
And the evolution operator
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
U_{block}=U_{0}(\tau)\bar{P}_{y}(\pi)\bar{P}_{y}(\varepsilon,{\cal H}_{0})U_{0}(2\tau)\bar{P}_{x}(\pi)\bar{P}_{x}(\varepsilon,{\cal H}_{0})U_{0}(2\tau)\cdot
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\cdot P_{y}(\pi)P_{y}(\varepsilon,{\cal H}_{0})U_{0}(2\tau)P_{x}(\pi)P_{x}(\varepsilon,{\cal H}_{0})U_{0}(\tau)=
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
=U_{0}(\tau)\bar{P}_{y}(\pi)\bar{P}_{x}(\pi)P_{y}(\pi)P_{x}(\pi)\bar{P}_{y_{3}}(\varepsilon,{\cal H}_{3})U_{3}(2\tau)\bar{P}_{x}(\varepsilon,{\cal H}_{2})U_{2}(2\tau)\cdot
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\cdot P_{y_{1}}(\varepsilon,{\cal H}_{1})U_{1}(2\tau)P_{x}(\varepsilon,{\cal H}_{0})U_{0}(\tau)=
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
=U_{0}(\tau)\bar{P}_{y_{3}}(\varepsilon,{\cal H}_{3})U_{3}(2\tau)\bar{P}_{x}(\varepsilon,{\cal H}_{2})U_{2}(2\tau)P_{y_{1}}(\varepsilon,{\cal H}_{1})U_{1}(2\tau)P_{x}(\varepsilon,{\cal H}_{0})U_{0}(\tau)
\]

\end_inset


\end_layout

\begin_layout Standard
The evolution operators between pulses in toggle-frame are
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
U_{1}=P_{x}^{\dagger}U_{0}P_{x}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
U_{2}=P_{x}^{\dagger}P_{y}^{\dagger}U_{0}P_{y}P_{x}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
U_{3}=P_{x}^{\dagger}P_{y}^{\dagger}\bar{P}_{x}^{\dagger}U_{0}\bar{P}_{x}P_{y}P_{x}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
And the evolution operators during pulses are
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
P_{y_{1}}(\varepsilon,{\cal H}_{1})=\exp(-iP_{x}^{\dagger}S_{y}P_{x}\varepsilon-i{\cal H}_{1}t_{w})=\exp(+iS_{y}\varepsilon-i{\cal H}_{1}t_{w})
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\bar{P}_{x_{2}}(\varepsilon,{\cal H}_{2})=\exp(+iP_{x}^{\dagger}P_{y}^{\dagger}S_{x}P_{y}P_{x}\varepsilon-i{\cal H}_{2}t_{w})=\exp(-iS_{x}\varepsilon-i{\cal H}_{2}t_{w})
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\bar{P}_{y_{3}}(\varepsilon,{\cal H}_{3})=\exp(+iP_{x}^{\dagger}P_{y}^{\dagger}\bar{P}_{x}^{\dagger}S_{y}\bar{P}_{x}P_{y}P_{x}\varepsilon-i{\cal H}_{3}t_{w})=\exp(+iS_{y}\varepsilon-i{\cal H}_{3}t_{w})
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
with the Hamiltonians in toggle frames are
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
{\cal H}_{0}=a_{\perp}\hat{S}_{y}\hat{I}_{x}+a_{\parallel}S_{y}I_{z}+\omega_{n}I_{z}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
{\cal H}_{1}=P_{x}^{\dagger}{\cal H}_{0}P_{x}=-a_{\perp}\hat{S}_{y}\hat{I}_{x}-a_{\parallel}S_{y}I_{z}+\omega_{n}I_{z}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
{\cal H}_{2}=P_{x}^{\dagger}P_{y}^{\dagger}{\cal H}_{0}P_{y}P_{x}=-a_{\perp}\hat{S}_{y}\hat{I}_{x}-a_{\parallel}S_{y}I_{z}+\omega_{n}I_{z}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
{\cal H}_{3}=P_{x}^{\dagger}P_{y}^{\dagger}\bar{P}_{x}^{\dagger}{\cal H}_{0}\bar{P}_{x}P_{y}P_{x}=\text{a_{\perp}\hat{S}_{y}\hat{I}_{x}+a_{\parallel}S_{y}I_{z}+\omega_{n}I_{z}}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Now we want to average Hamiltonian during pulse (?).
 So, we have
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
{\cal H}_{av}^{pulse}=\frac{1}{T}\sum_{i=0}^{3}{\cal H}_{i}\tau_{i}=\frac{1}{4t_{w}}(\varepsilon(S_{x}-S_{y}+S_{x}-S_{y})+t_{w}\omega_{n}I_{z})=
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
=\frac{1}{4t_{w}}(2\varepsilon(S_{x}-S_{y})+t_{w}\omega_{n}I_{z})
\]

\end_inset


\end_layout

\begin_layout Standard
Now we want to consider first order in Mangus expansion
\end_layout

